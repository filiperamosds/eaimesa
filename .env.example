# Copie para .env na raiz. Nunca commite valores reais.

# App
NODE_ENV=development
# Local só nesta máquina:
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Rede local (celular/tablet no mesmo Wi‑Fi — hostname .local do Mac):
APP_URL=http://mac-filipe.local:3000
API_URL=http://localhost:4000
# Browser: deixe vazio ou igual ao host que o celular usa; o front chama /v1 via proxy do Next.
# NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://mac-filipe.local:3000

# Database (Postgres 16 local — Mac Homebrew/Docker ou Cursor Cloud apt; ver docs/ops/dev-setup.md)
DATABASE_URL=postgresql://eaimesa:eaimesa@localhost:5432/eaimesa

# Auth — estabelecimento (cookie eaimesa_owner)
OWNER_JWT_SECRET=change-me-min-32-chars-random-owner
OWNER_JWT_TTL_HOURS=12

# Auth — guest session (fatia futura)
GUEST_SESSION_SECRET=change-me-min-32-chars-random-guest
GUEST_SESSION_TTL_HOURS=4

# Auth — staff (fatia futura)
STAFF_JWT_SECRET=change-me-min-32-chars-random-staff
STAFF_JWT_TTL_HOURS=12

# Claim do garçom (fatia futura)
CLAIM_TTL_SECONDS=180
CLAIM_MAX_ATTEMPTS=5

# Platform admin (futuro)
PLATFORM_JWT_SECRET=change-me-min-32-chars-random-platform

# Billing (futuro)
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_SECRET=
