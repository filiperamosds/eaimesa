# Copie para .env na raiz ou por app (quando existir código).
# Nunca commite valores reais.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://eaimesa:eaimesa@localhost:5432/eaimesa

# Auth — guest session (cookie)
GUEST_SESSION_SECRET=change-me-min-32-chars-random
GUEST_SESSION_TTL_HOURS=4

# Auth — staff JWT
STAFF_JWT_SECRET=change-me-min-32-chars-random
STAFF_JWT_TTL_HOURS=12

# Claim do garçom
CLAIM_TTL_SECONDS=180
CLAIM_MAX_ATTEMPTS=5

# Platform admin (futuro)
PLATFORM_JWT_SECRET=change-me-min-32-chars-random

# Billing (futuro)
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_SECRET=
